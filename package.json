{
  "name": "dijital-ziyaretci-sistemi",
  "version": "1.0.0",
  "description": "Dijital Ziyaretçi Karşılama ve Ekran Yönetim Sistemi",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test tests/**/*.test.js",
    "test:isolated": "cross-env TEST_DATABASE_URL=$TEST_DATABASE_URL node --test tests/**/*.test.js",
    "db:migrate": "npx prisma migrate deploy",
    "backup:db": "powershell -ExecutionPolicy Bypass -File .\\scripts\\export-db.ps1",
    "package:code": "powershell -ExecutionPolicy Bypass -File .\\scripts\\package-project.ps1",
    "package:uploads": "powershell -ExecutionPolicy Bypass -File .\\scripts\\package-uploads.ps1"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/msal-node": "^5.1.1",
    "@fontsource/noto-sans": "^5.2.10",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7.7.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.20.0",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "prisma": "7.7.0",
    "supertest": "^7.2.2"
  }
}
