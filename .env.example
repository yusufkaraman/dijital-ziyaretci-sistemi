# ──────────────────────────────────────────────────────────────
# Dijital Ziyaretçi Sistemi — Ortam Değişkenleri Şablonu
# Bu dosyayı kopyalayıp ".env" olarak kaydedin ve değerleri doldurun.
# cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ── PostgreSQL Bağlantısı ─────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here
POSTGRES_DB=dijital_ziyaretci

# Uygulama runtime bağlantısı (connection pool)
DATABASE_URL="postgresql://postgres:your-password-here@localhost:5432/dijital_ziyaretci?schema=public&connection_limit=10&pool_timeout=20"

# Migration ve admin komutları için doğrudan bağlantı
DIRECT_URL="postgresql://postgres:your-password-here@localhost:5432/dijital_ziyaretci?schema=public"

# ── Test Veritabanı (npm test için — production'dan ayrı!) ────
# docker-compose.test.yml ile 5433 portunda ayağa kaldırın.
POSTGRES_TEST_DB=dijital_ziyaretci_test
TEST_DATABASE_URL="postgresql://postgres:your-password-here@localhost:5433/dijital_ziyaretci_test?schema=public&connection_limit=5&pool_timeout=20"
TEST_DIRECT_URL="postgresql://postgres:your-password-here@localhost:5433/dijital_ziyaretci_test?schema=public"

# ── Uygulama Ayarları ─────────────────────────────────────────
PORT=3000
JWT_SECRET=your-secret-key-min-32-characters-here
ALLOWED_ORIGINS=http://localhost:3000

# ── Dosya Yüklemeleri ─────────────────────────────────────────
UPLOAD_PATH=./server/uploads

# ── Web Push Bildirimleri (web-push ile oluşturun) ────────────
# Oluşturmak için: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here

# ── Lobi Ekranı API Anahtarı ──────────────────────────────────
SCREEN_API_KEY=your-screen-api-key-here

# ── Azure / Outlook Entegrasyonu (opsiyonel) ──────────────────
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
REDIRECT_URI=http://localhost:3000/api/outlook/callback

# ── Hava Durumu Varsayılanı ───────────────────────────────────
DEFAULT_CITY=Ankara
