PORT=3000
NODE_ENV=production

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ALLOWED_ORIGINS=https://ziyaretci.sirket.com
SCREEN_API_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SCREEN_API_KEY

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PRODUCTION_DB_PASSWORD
