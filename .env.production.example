DATABASE_URL="postgresql://postgres:CHANGE_THIS_TO_A_STRONG_PRODUCTION_DB_PASSWORD@postgres:5432/dijital_ziyaretci?schema=public&connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://postgres:CHANGE_THIS_TO_A_STRONG_PRODUCTION_DB_PASSWORD@postgres:5432/dijital_ziyaretci?schema=public"

UPLOAD_PATH=/app/server/uploads
DEFAULT_CITY=Cankaya, Ankara

VAPID_PUBLIC_KEY=KEEP_YOUR_EXISTING_PUBLIC_KEY_OR_GENERATE_A_NEW_ONE
VAPID_PRIVATE_KEY=KEEP_YOUR_EXISTING_PRIVATE_KEY_OR_GENERATE_A_NEW_ONE

AZURE_TENANT_ID=
